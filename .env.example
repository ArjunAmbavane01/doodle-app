# apps/http-server/.env
PORT=8000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doodle"
JWT_SECRET="your-jwt-secret"
OPENAI_API_KEY="your-openai-api-key"

# apps/ws-server/.env
PORT=8080
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doodle"
JWT_SECRET="your-jwt-secret"
WS_JWT_SECRET="your-ws-jwt-secret"

# packages/db/.env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doodle"

# apps/web/.env.local
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_HTTP_BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_WS_BACKEND_URL="ws://localhost:8080"
